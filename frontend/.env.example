# Where the UI gets its data.
#   api   (default) the Django backend, with sign-in
#   demo  built-in synthetic data, no backend, no sign-in
VITE_DATA_MODE=api

# Dev server forwards /api to this address.
VITE_PROXY_TARGET=http://localhost:8000

# Never put the VirusTotal key (or any secret) in a VITE_* variable: those are shipped to the browser.
