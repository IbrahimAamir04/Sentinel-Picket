# Copy to .env (never commit .env). Read by the Django backend.

DEBUG=True
# Required when DEBUG is off. Generate: python -c "import secrets; print(secrets.token_urlsafe(60))"
SECRET_KEY=
ALLOWED_HOSTS=localhost,127.0.0.1

# PostgreSQL is the supported database. Without this, a local SQLite file is used (quick trials only).
DATABASE_URL=postgres://sentinel:CHANGE_ME@127.0.0.1:5432/sentinel

# Only needed if the SPA is served from a different origin than the API (default: same origin via the Vite proxy).
CORS_ALLOWED_ORIGINS=
CSRF_TRUSTED_ORIGINS=http://localhost:5173

# Marks the server as holding synthetic data and allows `seed_demo`. Never enable alongside real telemetry.
SENTINEL_DEMO_MODE=False

# Sensor health thresholds (seconds without a heartbeat).
SENSOR_WARNING_AFTER_SECONDS=120
SENSOR_OFFLINE_AFTER_SECONDS=600

# Ingestion limits and severity mapping (defaults shown). See docs/INGESTION.md.
# INGEST_MAX_EVENTS_PER_REQUEST=500
# INGEST_MAX_BODY_BYTES=2097152
# INGEST_MAX_EVENT_AGE_DAYS=30
# INGEST_MAX_FUTURE_SKEW_SECONDS=300
# INGEST_AUTH_FAIL_LIMIT=20
# THROTTLE_INGEST=120/min
# THROTTLE_HEARTBEAT=20/min
# SENTINEL_CRITICAL_CLASSIFICATIONS=trojan-activity,successful-admin,successful-user,shellcode-detect

# Production only
SECURE_COOKIES=
SECURE_SSL_REDIRECT=False
BEHIND_TLS_PROXY=False

# Later phases. Declared now so the contract is stable; nothing reads them yet.
# The VirusTotal key lives on the backend only. It must never appear in a VITE_* variable or in API responses.
VIRUSTOTAL_API_KEY=
REDIS_URL=
